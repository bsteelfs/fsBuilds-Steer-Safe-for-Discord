# ==============================================================================
# ENVIRONMENT CONFIGURATION
# ------------------------------------------------------------------------------
# Copy this file to `.env` and fill in each value. `.env` is gitignored and must
# NEVER be committed. Each variable notes exactly where to find its value.
# ==============================================================================


# ─────────────────────────────────────────────────────────────
# Discord Application
# https://discord.com/developers/applications
# ─────────────────────────────────────────────────────────────

# WHERE: Developer Portal → your application → "Bot" → "Reset Token".
# NOTE:  Shown only once; reset it if you lose it. Treat it like a password.
DISCORD_TOKEN=

# WHERE: Developer Portal → your application → "General Information" →
#        "Application ID" (also called the Client ID).
DISCORD_CLIENT_ID=

# WHERE: Discord app (not the portal) → enable Developer Mode
#        (User Settings → Advanced → Developer Mode), then right-click your
#        server icon → "Copy Server ID".
# WHY:   Slash commands register to this guild, which makes them appear
#        instantly — ideal for development.
DISCORD_GUILD_ID=


# ─────────────────────────────────────────────────────────────
# Optional roles (both may be left blank)
# WHERE: Developer Mode on → Server Settings → Roles → right-click a role →
#        "Copy Role ID".
# ─────────────────────────────────────────────────────────────

# VIP role. A user is VIP if their linked FastSpring account has an active
# subscription OR they hold this role. Blank = subscription-based VIP only.
DISCORD_VIP_ROLE_ID=

# Role allowed to run /announce. Blank = anyone with the Manage Server
# permission can run it.
DISCORD_CM_ROLE_ID=


# ─────────────────────────────────────────────────────────────
# FastSpring API (Basic Auth on all API calls)
# ─────────────────────────────────────────────────────────────

# WHERE: FastSpring Dashboard → Integrations → API Credentials
#        (https://app.fastspring.com/settings/api) → "Create Credentials".
# NOTE:  The password is shown only at creation time — store it immediately.
FASTSPRING_API_USER=
FASTSPRING_API_PASSWORD=

# WHERE: FastSpring Dashboard → Integrations → Webhooks → your endpoint →
#        "HMAC SHA256 Secret". Use the SAME value here and in the dashboard —
#        it's how the bot proves an inbound webhook really came from FastSpring
#        (see src/web/routes/webhook.js).
FS_WEBHOOK_SECRET=

# The FastSpring-hosted web shop the /store buy buttons deep-link into.
# WHERE: Dashboard → Store → Storefronts (Web Storefront).
# IMPORTANT: include the scheme (https://) — the bot parses this with new URL()
# and will throw ERR_INVALID_URL without it.
# The bot appends ?prod=&uid=&uname= to pre-fill the cart and carry the buyer's
# Discord identity through to the order as FastSpring order tags.
WEBSHOP_URL=https://your-store.onfastspring.com/your-storefront


# ─────────────────────────────────────────────────────────────
# Server
# ─────────────────────────────────────────────────────────────

# Port the webhook HTTP server listens on.
PORT=3000
